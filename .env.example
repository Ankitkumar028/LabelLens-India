# LabelLens India - Environment Configuration
# LLM Provider selection: mock | gemini | vllm
LLM_PROVIDER=mock

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Storage / Retention
MAX_IMAGE_SIZE_MB=8
IMAGE_RETENTION_HOURS=24
DATABASE_URL=sqlite:///./scans.db

# Gemini Provider (Phases 3 & 6 fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# vLLM Provider (Phase 5 AMD ROCm GPU droplet)
VLLM_API_BASE=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Rules Configuration Path
RULES_CONFIG_PATH=config/rules.yaml

# Observability Configuration (Prometheus & Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Production Deployment (Render / Fly / Cloudflare)
PRODUCTION_URL=
RENDER_DEPLOY_HOOK_API=
RENDER_DEPLOY_HOOK_WEB=

