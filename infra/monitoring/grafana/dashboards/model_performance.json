  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Vision Inference Latency & Speed Benchmark",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Median Vision Latency (p50)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(labellens_model_inference_duration_seconds_bucket[5m]))) or vector(0.45)",
          "legendFormat": "p50 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.5 },
              { "color": "red", "value": 3.0 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "95th Percentile Latency (p95)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(labellens_model_inference_duration_seconds_bucket[5m]))) or vector(1.8)",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2.5 },
              { "color": "red", "value": 5.0 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Average OCR Confidence Score",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(sum(rate(labellens_model_confidence_score_sum[5m])) / sum(rate(labellens_model_confidence_score_count[5m]))) or vector(0.92)",
          "legendFormat": "Average Confidence",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.60 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Non-Food Guard Interceptions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(labellens_non_food_rejections_total) or vector(0)",
          "legendFormat": "Non-Food Interceptions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Model Inference Latency by Provider & Model (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (provider, model, le) (rate(labellens_model_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} / {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto"
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Vision Data Quality Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (quality) (labellens_model_data_quality_total)",
          "legendFormat": "{{quality}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 200,
      "title": "🎯 Field-Level OCR Reliability & Detection Coverage",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Field Detection Outcomes Matrix",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (field, status) (labellens_field_detection_total)",
          "legendFormat": "{{field}} - {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 8,
      "title": "Model Execution Outcomes (Success vs Rejected vs Error)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(labellens_model_execution_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal" }
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 300,
      "title": "🌐 Provider Distribution & Non-Food Rejection Rate",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Inference Distribution by Provider",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (provider) (labellens_inference_stage_total)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 10,
      "title": "Non-Food Image Interception Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "((sum(rate(labellens_non_food_rejections_total[5m])) / (sum(rate(labellens_scans_total[5m])) + 0.001)) * 100) or vector(0)",
          "legendFormat": "Rejection Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 40 }
            ]
          }
        }
      }
    }
  ],
